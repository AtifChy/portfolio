---
import type { PortfolioGitHubData } from "../lib/github";

interface Props {
  data: PortfolioGitHubData;
}

const { data } = Astro.props;
const { user, totalStars, languages } = data;
---

<div class="w-full grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 my-8">
  <!-- Card 1: GitHub Stars -->
  <div class="glass-panel rounded-2xl p-4 sm:p-5 relative overflow-hidden group">
    <div class="absolute top-0 right-0 w-24 h-24 bg-amber-500/10 rounded-full blur-2xl group-hover:bg-amber-500/20 transition-all"></div>
    <div class="flex items-center justify-between text-xs font-mono text-neutral-400 mb-2">
      <span>OPEN SOURCE</span>
      <span class="text-amber-400">★ Stars</span>
    </div>
    <div class="flex items-baseline gap-2">
      <span class="text-2xl sm:text-3xl font-bold font-serif text-white tracking-tight">
        {totalStars}+
      </span>
      <span class="text-xs text-neutral-400">earned</span>
    </div>
    <p class="text-xs text-neutral-400 mt-2 line-clamp-1">
      Across {user.public_repos}+ public repositories
    </p>
  </div>

  <!-- Card 2: Academic Standing -->
  <div class="glass-panel rounded-2xl p-4 sm:p-5 relative overflow-hidden group">
    <div class="absolute top-0 right-0 w-24 h-24 bg-blue-500/10 rounded-full blur-2xl group-hover:bg-blue-500/20 transition-all"></div>
    <div class="flex items-center justify-between text-xs font-mono text-neutral-400 mb-2">
      <span>ACADEMICS</span>
      <span class="text-blue-400">AIUB</span>
    </div>
    <div class="flex items-baseline gap-2">
      <span class="text-2xl sm:text-3xl font-bold font-serif text-white tracking-tight">
        3.83
      </span>
      <span class="text-xs text-neutral-400">/ 4.00 CGPA</span>
    </div>
    <p class="text-xs text-neutral-400 mt-2 line-clamp-1">
      B.Sc. in Computer Science & Eng.
    </p>
  </div>

  <!-- Card 3: Systems & Native -->
  <div class="glass-panel rounded-2xl p-4 sm:p-5 relative overflow-hidden group">
    <div class="absolute top-0 right-0 w-24 h-24 bg-cyan-500/10 rounded-full blur-2xl group-hover:bg-cyan-500/20 transition-all"></div>
    <div class="flex items-center justify-between text-xs font-mono text-neutral-400 mb-2">
      <span>CORE STACK</span>
      <span class="text-cyan-400">Systems</span>
    </div>
    <div class="flex items-baseline gap-2">
      <span class="text-2xl sm:text-3xl font-bold font-serif text-white tracking-tight">
        Go + Rust
      </span>
    </div>
    <p class="text-xs text-neutral-400 mt-2 line-clamp-1">
      Wails v3, WinRT, Concurrent APIs
    </p>
  </div>

  <!-- Card 4: ML & Fullstack -->
  <div class="glass-panel rounded-2xl p-4 sm:p-5 relative overflow-hidden group">
    <div class="absolute top-0 right-0 w-24 h-24 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-all"></div>
    <div class="flex items-center justify-between text-xs font-mono text-neutral-400 mb-2">
      <span>APPLIED AI</span>
      <span class="text-emerald-400">PyTorch & React</span>
    </div>
    <div class="flex items-baseline gap-2">
      <span class="text-2xl sm:text-3xl font-bold font-serif text-white tracking-tight">
        Python + TS
      </span>
    </div>
    <p class="text-xs text-neutral-400 mt-2 line-clamp-1">
      SentenceTransformers, React 19, FastAPI
    </p>
  </div>
</div>

<!-- Language Distribution Bar -->
<div class="glass-panel rounded-2xl p-4 sm:p-5 mb-12">
  <div class="flex items-center justify-between text-xs font-mono text-neutral-400 mb-3">
    <span class="flex items-center gap-2">
      <svg class="w-4 h-4 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/>
      </svg>
      Primary Codebase Distribution (Live GitHub Aggregation)
    </span>
    <a href="/projects" class="text-blue-400 hover:text-blue-300 transition-colors flex items-center gap-1">
      Browse all repos →
    </a>
  </div>

  <!-- Progress bar -->
  <div class="h-2.5 w-full rounded-full bg-white/5 overflow-hidden flex gap-[2px]">
    {languages.map((lang) => (
      <div
        style={`width: ${lang.percentage}%; background-color: ${lang.color};`}
        class="h-full transition-all duration-500 hover:opacity-80"
        title={`${lang.name}: ${lang.percentage}%`}
      />
    ))}
  </div>

  <!-- Legend -->
  <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-3.5 text-xs">
    {languages.map((lang) => (
      <div class="flex items-center gap-1.5 font-mono text-neutral-300">
        <span
          class="w-2.5 h-2.5 rounded-full"
          style={`background-color: ${lang.color};`}
        />
        <span>{lang.name}</span>
        <span class="text-neutral-400">({lang.percentage}%)</span>
      </div>
    ))}
  </div>
</div>
