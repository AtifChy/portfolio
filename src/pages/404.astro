---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 — Page Not Found | Md. Iftakhar Awal Chowdhury"
  description="The requested page could not be found."
>
  <div class="py-24 text-center space-y-6 max-w-lg mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-red-500/10 text-red-400 border border-red-500/20">
      404 ERROR
    </div>

    <h1 class="text-5xl sm:text-6xl font-serif font-bold text-white tracking-tight">
      Page not found
    </h1>

    <p class="text-neutral-400 text-sm leading-relaxed font-sans">
      The link you followed might be broken, or the page may have been moved.
    </p>

    <div class="pt-4 flex items-center justify-center gap-4">
      <a
        href="/"
        class="px-5 py-2.5 rounded-xl text-sm font-medium bg-blue-600 hover:bg-blue-500 text-white transition-colors"
      >
        Return Home
      </a>
      <a
        href="/projects"
        class="px-5 py-2.5 rounded-xl text-sm font-medium border border-white/10 bg-white/5 hover:bg-white/10 text-neutral-300 transition-colors"
      >
        Browse Projects
      </a>
    </div>
  </div>
</BaseLayout>
