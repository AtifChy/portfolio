---
import BaseLayout from "./BaseLayout.astro";
import TechBadge from "../components/TechBadge.astro";

interface Props {
  project: {
    title: string;
    tagline: string;
    description: string;
    category: string;
    role: string;
    period: string;
    stack: string[];
    githubUrl?: string;
    liveUrl?: string;
    releaseUrl?: string;
    stats?: Record<string, string>;
    keyHighlights?: string[];
    architectureDecisions?: Array<{
      decision: string;
      rationale: string;
    }>;
  };
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} — Case Study by Md. Iftakhar Awal Chowdhury`}
  description={project.description}
  type="article"
>
  <article class="max-w-4xl mx-auto py-6 sm:py-10">
    <!-- Back link -->
    <div class="mb-8">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 text-xs font-mono text-neutral-400 hover:text-white transition-colors"
      >
        <span>←</span>
        <span>Back to Featured Projects</span>
      </a>
    </div>

    <!-- Case Study Header -->
    <header class="space-y-4 mb-10 pb-8 border-b border-white/10">
      <div class="flex flex-wrap items-center gap-2.5 text-xs font-mono">
        <span class="px-2.5 py-1 rounded-md bg-blue-500/10 text-blue-400 border border-blue-500/20 font-medium">
          {project.category}
        </span>
        <span class="text-neutral-400">•</span>
        <span class="text-neutral-300">{project.role}</span>
        <span class="text-neutral-400">•</span>
        <span class="text-neutral-400">{project.period}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-white tracking-tight leading-tight">
        {project.title}
      </h1>

      <p class="text-lg sm:text-xl font-mono text-blue-400">
        {project.tagline}
      </p>

      <p class="text-neutral-300 text-base leading-relaxed max-w-3xl">
        {project.description}
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-3">
        {project.githubUrl && (
          <a
            href={project.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-mono font-medium border border-white/15 bg-white/5 hover:bg-white/10 text-white transition-all shadow-sm"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>GitHub Repository</span>
          </a>
        )}

        {project.liveUrl && (
          <a
            href={project.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-mono font-medium bg-emerald-600 hover:bg-emerald-500 text-white shadow-md shadow-emerald-600/20 transition-all"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            <span>Live Project</span>
          </a>
        )}
      </div>

      <!-- Tech Stack Badges -->
      <div class="flex flex-wrap gap-1.5 pt-2">
        {project.stack.map((t) => (
          <TechBadge name={t} size="sm" />
        ))}
      </div>
    </header>

    <!-- Metrics Grid -->
    {project.stats && Object.keys(project.stats).length > 0 && (
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 my-8">
        {Object.entries(project.stats).map(([k, v]) => (
          <div class="glass-panel rounded-xl p-4 border border-white/10">
            <span class="text-[11px] font-mono text-neutral-400 uppercase block mb-1">
              {k}
            </span>
            <span class="text-sm sm:text-base font-serif font-bold text-white">
              {v}
            </span>
          </div>
        ))}
      </div>
    )}

    <!-- Architecture Decisions & Trade-Offs (ADR) -->
    {project.architectureDecisions && project.architectureDecisions.length > 0 && (
      <div class="glass-panel rounded-2xl p-6 sm:p-8 my-8 border border-white/10">
        <h3 class="text-lg font-serif font-bold text-white mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 2 7 12 12 22 7 12 2"/>
            <polyline points="2 17 12 22 22 17"/>
            <polyline points="2 12 12 17 22 12"/>
          </svg>
          Architecture Decisions & Trade-Offs
        </h3>

        <div class="space-y-4">
          {project.architectureDecisions.map((ad, idx) => (
            <div class="p-4 rounded-xl bg-white/[0.03] border border-white/5 space-y-1.5">
              <span class="text-xs font-mono text-blue-400 font-semibold">
                Decision #{idx + 1}: {ad.decision}
              </span>
              <p class="text-xs text-neutral-300 leading-relaxed">
                <strong class="text-neutral-400 font-mono">Rationale:</strong> {ad.rationale}
              </p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Main Markdown Body -->
    <div class="prose-custom my-10">
      <slot />
    </div>

    <!-- Footer Navigation -->
    <div class="border-t border-white/10 pt-8 mt-12 flex items-center justify-between">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-xs font-mono text-neutral-400 hover:text-white transition-colors"
      >
        <span>← All Repositories</span>
      </a>

      <a
        href="/#contact"
        class="inline-flex items-center gap-2 text-xs font-mono text-blue-400 hover:text-blue-300 transition-colors"
      >
        <span>Discuss this project →</span>
      </a>
    </div>
  </article>
</BaseLayout>
